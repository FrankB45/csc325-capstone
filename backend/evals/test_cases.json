[
  {
    "name": "valid recommendations are accepted in history order",
    "history": [
      "0000000000000000000000000000000000000001",
      "0000000000000000000000000000000000000002",
      "0000000000000000000000000000000000000003"
    ],
    "mock_ai_response": {
      "selected_commits": [
        "0000000000000000000000000000000000000003",
        "0000000000000000000000000000000000000001"
      ]
    },
    "expected_valid": true
  },
  {
    "name": "unknown commit recommendations are rejected",
    "history": [
      "0000000000000000000000000000000000000001",
      "0000000000000000000000000000000000000002"
    ],
    "mock_ai_response": {
      "selected_commits": [
        "ffffffffffffffffffffffffffffffffffffffff"
      ]
    },
    "expected_valid": false
  },
  {
    "name": "duplicate recommendations are rejected",
    "history": [
      "0000000000000000000000000000000000000001",
      "0000000000000000000000000000000000000002"
    ],
    "mock_ai_response": {
      "selected_commits": [
        "0000000000000000000000000000000000000001",
        "0000000000000000000000000000000000000001"
      ]
    },
    "expected_valid": false
  },
  {
    "name": "empty recommendations are rejected",
    "history": [
      "0000000000000000000000000000000000000001"
    ],
    "mock_ai_response": {
      "selected_commits": []
    },
    "expected_valid": false
  },
  {
    "name": "over-limit recommendations are rejected",
    "history": [
      "0000000000000000000000000000000000000001",
      "0000000000000000000000000000000000000002",
      "0000000000000000000000000000000000000003",
      "0000000000000000000000000000000000000004",
      "0000000000000000000000000000000000000005",
      "0000000000000000000000000000000000000006",
      "0000000000000000000000000000000000000007",
      "0000000000000000000000000000000000000008",
      "0000000000000000000000000000000000000009",
      "0000000000000000000000000000000000000010",
      "0000000000000000000000000000000000000011"
    ],
    "mock_ai_response": {
      "selected_commits": [
        "0000000000000000000000000000000000000001",
        "0000000000000000000000000000000000000002",
        "0000000000000000000000000000000000000003",
        "0000000000000000000000000000000000000004",
        "0000000000000000000000000000000000000005",
        "0000000000000000000000000000000000000006",
        "0000000000000000000000000000000000000007",
        "0000000000000000000000000000000000000008",
        "0000000000000000000000000000000000000009",
        "0000000000000000000000000000000000000010",
        "0000000000000000000000000000000000000011"
      ]
    },
    "expected_valid": false
  },
  {
    "name": "malformed response is rejected",
    "history": [
      "0000000000000000000000000000000000000001"
    ],
    "mock_ai_response": {
      "selected_commits": "not-a-list"
    },
    "expected_valid": false
  },
  {
    "contract": "comparison_result",
    "name": "comparison result with changes and limitations is accepted",
    "mock_ai_response": {
      "changes": [
        {
          "element": "Page color palette",
          "location": "Page background and header",
          "file_path": "styles.css",
          "description": "The background changes from blue to dark navy, with light text in the header."
        }
      ],
      "limitations": [
        "The screenshots show only one viewport size.",
        "Source context includes only HTML, CSS, and JavaScript."
      ]
    },
    "expected_valid": true
  },
  {
    "contract": "comparison_result",
    "name": "comparison change missing a required field is rejected",
    "mock_ai_response": {
      "changes": [
        {
          "element": "Page color palette",
          "location": "Page background",
          "file_path": "styles.css"
        }
      ],
      "limitations": []
    },
    "expected_valid": false
  },
  {
    "contract": "comparison_result",
    "name": "comparison changes must be a list",
    "mock_ai_response": {
      "changes": "No changes",
      "limitations": []
    },
    "expected_valid": false
  },
  {
    "contract": "comparison_result",
    "name": "comparison limitations must be strings",
    "mock_ai_response": {
      "changes": [],
      "limitations": [
        42
      ]
    },
    "expected_valid": false
  }
